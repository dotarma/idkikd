/* ╔══════════════════════════════════════════════════════════╗
   ║  rofi powermenu.rasi — compact centered power menu     ║
   ║  Place : ~/.config/rofi/powermenu.rasi                 ║
   ╚══════════════════════════════════════════════════════════╝ */

@import "config.rasi"

window {
    width:          300px;
    border:         2px solid;
    border-color:   @red;
    border-radius:  0px;
}

mainbox {
    children:   [ inputbar, listview ];
    spacing:    0px;
    padding:    0px;
}

inputbar {
    background-color:   @mantle;
    border:             0px 0px 1px 0px;
    border-color:       @surface1;
    padding:            10px 14px;
}

listview {
    lines:      5;
    padding:    6px;
    spacing:    2px;
    fixed-height: true;
}

element selected.normal {
    background-color:   @surface0;
    text-color:         @red;
    border:             0px 0px 0px 2px;
    border-color:       @red;
}

element-text {
    text-color: inherit;
    font:       "JetBrains Mono 10";
}
